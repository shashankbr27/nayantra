  {
    "name": "create_task",
    "description": "Create a structured task; Nayantra chooses the robot (capability, distance, battery, workload, traffic), plans the route and coordinates traffic. Places may be waypoint names or areas like 'receiving'/'storage'.",
    "parameters": {
      "task_type": {
        "description": "What to do",
        "enum": [
          "navigate",
          "delivery",
          "patrol",
          "inspect",
          "charge",
          "dock",
          "takeoff",
          "land"
        ],
        "type": "string"
      },
      "destination": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "navigate: waypoint or area name"
      },
      "pickup": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "delivery: pickup waypoint or area (e.g. 'receiving')"
      },
      "dropoff": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "delivery: dropoff waypoint or area (e.g. 'storage')"
      },
      "payload": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "delivery: what is carried"
      },
      "waypoints": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "patrol: places in order"
      },
      "rounds": {
        "anyOf": [
          {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "patrol: repetitions"
      },
      "target": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "inspect/charge/dock/land: specific place (optional for charge/dock/land)"
      },
      "count": {
        "default": 1,
        "description": "How many identical tasks (e.g. 3 packages → 3)",
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      },
      "priority": {
        "default": 5,
        "description": "Traffic/queue priority, 9 = most urgent",
        "maximum": 9,
        "minimum": 0,
        "type": "integer"
      },
      "fleet_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Restrict to one fleet (optional)"
      },
      "robot": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "ONLY if the operator named a specific robot; otherwise leave empty so Nayantra allocates"
      }
    },
    "required": [
      "task_type"
    ],
    "risk": "act",
    "api_endpoint": "POST /tasks"
  },
  {
    "name": "get_task_status",
    "description": "Status of a task with the reasons: why it is waiting, why this robot was selected, steps, recent trace.",
    "parameters": {
      "task_id": {
        "description": "Task id, e.g. 'T-0007'",
        "type": "string"
      }
    },
    "required": [
      "task_id"
    ],
    "risk": "read",
    "api_endpoint": "GET /tasks/{id}/trace"
  },
  {
    "name": "list_tasks",
    "description": "List tasks (open ones by default) with status and reasons.",
    "parameters": {
      "status": {
        "anyOf": [
          {
            "enum": [
              "active",
              "queued",
              "assigned",
              "executing",
              "waiting_for_traffic",
              "waiting_for_robot",
              "paused",
              "completed",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "active",
        "description": "'active' = every open task"
      },
      "robot": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "limit": {
        "default": 20,
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [],
    "risk": "read",
    "api_endpoint": "GET /tasks"
  },
