    "api_endpoint": "GET /fleets"
  },
  {
    "name": "get_fleet_state",
    "description": "Live state of one fleet and each of its robots.",
    "parameters": {
      "fleet_id": {
        "description": "Fleet id (from list_fleets)",
        "type": "string"
      }
    },
    "required": [
