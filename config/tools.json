  {
    "name": "list_robots",
    "description": "List robots with live status, battery, location, current task and why they are in that state. Use this to answer 'which robots are available / charging / busy'.",
    "parameters": {
      "fleet_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Only this fleet"
      },
      "status": {
        "anyOf": [
          {
            "enum": [
              "idle",
              "moving",
              "waiting",
              "paused",
              "charging",
              "acting",
              "error",
              "emergency_stop",
              "offline"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Only robots in this status (e.g. 'charging')"
      }
    },
    "required": [],
    "risk": "read",
    "api_endpoint": "GET /robots"
  },
  {
    "name": "get_robot_state",
    "description": "Full live state of one robot: status, why it is waiting, route, ETA, battery, health, current task.",
    "parameters": {
      "robot": {
        "description": "Robot id or name, e.g. 'ugv_03' or 'UGV-03'",
        "type": "string"
      }
    },
    "required": [
      "robot"
    ],
    "risk": "read",
    "api_endpoint": "GET /robots/{id}"
  },
  {
    "name": "get_map",
