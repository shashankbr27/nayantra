# Nayantra Core: control plane + operator UI (port 8000).
# Stage 1 builds the web UI; stage 2 runs the core and serves it.
FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY nayantra/ ./nayantra/
COPY scripts/ ./scripts/
COPY config/ ./config/
RUN pip install --no-cache-dir .
COPY --from=web /web/dist ./web/dist

ENV CORE_HOST=0.0.0.0 CORE_PORT=8000 WEB_DIST_DIR=/app/web/dist NAYANTRA_DB_PATH=/data/nayantra.db
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"
CMD ["nayantra-core"]
